# kiro2cc-proxy 服务器环境变量配置
# 复制为 .env 并修改

# 必填
API_KEY=sk-kiro2cc-proxy-your-key

# 可选
# ADMIN_PSW=sk-admin-your-key
# PORT=8990
# HOST=0.0.0.0  # 警告：设为 0.0.0.0 会监听所有网络接口，请确保有防火墙保护
# REGION=us-east-1
# AUTH_REGION=us-east-1
# API_REGION=us-east-1
# PROXY_URL=http://127.0.0.1:7890
# PROXY_USERNAME=
# PROXY_PASSWORD=
# LOAD_BALANCING_MODE=priority
# MAX_RPM_PER_CREDENTIAL=10  # 每账号每分钟实际转发尝试数，0 显式关闭 RPM 保护
# MAX_CONCURRENT_REQUESTS=20
# MAX_CONCURRENT_PER_CREDENTIAL=2
# UPSTREAM_ADMISSION_TIMEOUT_SECS=30
# ACCOUNT_RECOVERY_COOLDOWN_SECS=300
# ACCOUNT_RECOVERY_MAX_COOLDOWN_SECS=3600
# ACCOUNT_RECOVERY_PROBE_TIMEOUT_SECS=30
# PROXY_HEALTH_CHECK_URL=https://checkip.amazonaws.com/
# PROXY_HEALTH_CHECK_TIMEOUT_SECS=10
# PROXY_HEALTH_CHECK_INTERVAL_SECS=300
# PROXY_HEALTH_CHECK_CONCURRENCY=4
# PROXY_FAILURE_COOLDOWN_SECS=60
# KIRO_LOG_DIR=/var/log/kiro2cc-proxy
