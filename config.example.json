  "accountRecoveryProbeTimeoutSecs": 30,
  "proxyHealthCheckUrl": "https://checkip.amazonaws.com/",
  "proxyHealthCheckTimeoutSecs": 10,
  "proxyHealthCheckIntervalSecs": 300,
  "proxyHealthCheckConcurrency": 4,
  "proxyFailureCooldownSecs": 60
}
