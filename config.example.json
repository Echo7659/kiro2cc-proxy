{
  "host": "127.0.0.1",
  "port": 5678,
  "tlsBackend": "rustls",
  "region": "us-east-1",
  "adminPsw": "sk-admin-your-secret-key",
  "clientTokenPassthrough": false,
  "maxRpmPerCredential": 10,
  "maxConcurrentRequests": 20,
